{
  "name": "rkeychat-app",
  "private": true,
  "version": "0.3.11",
  "description": "The rKeyChat shell: projects and their conversations, on PearKit. Served by the daemon at /app/.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
