    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
