{
  "expo": {
    "name": "rKeyChat",
    "slug": "rkeychat",
    "version": "0.3.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bitcoinaudible.rkeychat",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "rKeyChat records voice memos and dictation. Audio stays on your devices.",
        "NSLocalNetworkUsageDescription": "rKeyChat connects directly to your other devices and people you chat with.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "rKeyChat uses the camera to scan login codes and room invites."
      },
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.bitcoinaudible.rkeychat",
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#09090b",
    "splash": {
      "backgroundColor": "#09090b"
    }
  }
}
