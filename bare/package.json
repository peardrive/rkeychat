  "scripts": {
    "sync": "node sync-core.js",
    "start": "node sync-core.js && bare daemon.js",
    "spike": "bare spike.js"
  },
  "dependencies": {
    "pearcore": "file:../../pearcore-mobile",
    "bare-sqlite": "^0.1.4",
