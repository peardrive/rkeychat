    "bare-encoding": "^1.0.0",
    "fs": "npm:bare-fs@^4.8.2",
    "path": "npm:bare-path@^3.1.2",
    "os": "npm:bare-os@^3.9.3",
    "events": "npm:bare-events@^2.9.2",
    "zlib": "file:./shims/zlib",
    "url": "npm:bare-url@^2.5.4",
    "crypto": "npm:bare-crypto@^1.12.0",
    "http": "npm:bare-http1@^4",
    "child_process": "file:./shims/child_process",
    "module": "file:./shims/module",
    "rkey": "file:../../rKey",
