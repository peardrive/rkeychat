{"nodes": [{"id": "plan_rkeychat_daemon", "label": "rkeychat Daemon", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Node daemon per machine joins the room's pearcore space and hosts participants; the machine's pearcore key only carries traffic, identity comes from rKey participant keys."}, {"id": "plan_participant", "label": "Participant (rKey chat-scope key)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each participant has its own key enrolled under Guy's rKey root with the chat scope; every message is signed and membership checked against the chain on every message."}, {"id": "plan_live_lane", "label": "Live lane (pearcore MessageService)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses pearcore MessageService which already signs, encrypts with the space secret and relays. Envelope {app:'rkeychat', v:0, type}; PearDrive ignores it because the app tag doesn't match."}, {"id": "plan_message_types", "label": "Live message types (msg, chain, hist-req/res, presence, control)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_durable_lane", "label": "Durable lane (hash-chained archive)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sealed, immutable per-day files so PearDrive never churns re-hashing a growing file; day header {v, room, day, prev, count, root} links days into a tamper-evident chain; month/year rollups keep the reader's index small."}, {"id": "plan_archivist", "label": "Archivist (room-owner device)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The room-owner device writes the archive because it has everything after sync; other devices only verify."}, {"id": "plan_hist_req_backfill", "label": "hist-req 48h id-set backfill", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_gui", "label": "rKeyChat GUI (localhost page + event stream)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_hermes_bridge", "label": "Hermes bridge", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Hermes' local API server (127.0.0.1:8642), one session per room; new messages are batched, POSTed to /api/sessions/{id}/chat/stream, reply streamed back and posted."}, {"id": "plan_claude_code_bridge", "label": "Claude Code bridge (tail/wait under Monitor, send)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "Pieces 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each line from rkeychat tail wakes the Claude session via the Monitor tool; fallback is claude -p --resume."}, {"id": "plan_turn_taking_budget", "label": "Turn-taking and round budget", "file_type": "rationale", "source_file": "PLAN.md", "source_location": "Pieces 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A message from Guy resets the budget; each agent-to-agent reply spends a round; at 0 agents stop until Guy posts or extends. Default 3 autonomous rounds, extendable +N, until a time, or unlimited; one turn at a time per agent with batching while busy."}, {"id": "plan_peardrive_transfer_fallback", "label": "PearDrive transfer fallback to pearcore native protocol", "file_type": "concept", "source_file": "PLAN.md", "source_location": "PearDrive work needed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PearDrive only downloads over its own 0x03 lane so it cannot pull files from a plain pearcore peer; without a fallback it can serve rKeyChat history but not back it up."}, {"id": "plan_retire_agent_mesh", "label": "Retire src/engine/agent.js (Agent Mesh)", "file_type": "concept", "source_file": "PLAN.md", "source_location": "PearDrive work needed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Superseded by rKeyChat; Guy's verdict: nobody used it, he couldn't see inside it, and he still had to copy-paste between agents."}], "edges": [{"source": "plan_rkeychat_daemon", "target": "plan_participant", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN.md", "source_location": "Pieces 1", "weight": 1.0}, {"source": "plan_rkeychat_daemon", "target": "plan_live_lane", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN.md", "source_location": "Pieces 2", "weight": 1.0}, {"source": "plan_live_lane", "target": "plan_message_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN.md", "source_location": "Pieces 2", "weight": 1.0}, {"source": "plan_durable_lane", "target": "plan_archivist", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN.md", "source_location": "Pieces 3", "weight": 1.0}, {"source": "plan_durable_lane", "target": "plan_hist_req_backfill", "relation": "conceptually_related_to