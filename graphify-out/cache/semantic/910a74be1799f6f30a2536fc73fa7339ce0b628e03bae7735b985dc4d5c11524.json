{"nodes": [{"id": "docs_peardrive_space_directories_space_directory_model", "label": "Space directories decoupled from disk", "file_type": "rationale", "source_file": "docs/peardrive-space-directories.md", "source_location": "The model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A space is its own root; space directories are signed records synced to members; a file is a link to content by hash, never a path; fixes the redundant folder inside every space, folder-name collisions across machines, and the 20 GB dedupe that made a second directory look empty."}, {"id": "docs_peardrive_space_directories_local_index", "label": "Local index (hash \u2192 disk location, per device)", "file_type": "concept", "source_file": "docs/peardrive-space-directories.md", "source_location": "Plan B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores hash, size, inode, volume id and a cheap fingerprint so moves self-heal via FSEvents/inotify; private paths never leave the device."}, {"id": "docs_peardrive_space_directories_connection", "label": "Connection (watch folder \u2192 space directory; collect/mirror, flatten/subtree)", "file_type": "concept", "source_file": "docs/peardrive-space-directories.md", "source_location": "The model, edge cases 4-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many-to-many bridge between disk and space; collect (additions only) is the default because the space is the archive and the folder is just an inbox."}, {"id": "docs_peardrive_space_directories_dir_entry_record", "label": "dir-entry record", "file_type": "concept", "source_file": "docs/peardrive-space-directories.md", "source_location": "Plan A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guy dropped the per-entry versions list: a different hash is a different file; version history is a policy layer on top."}, {"id": "docs_peardrive_space_directories_names_as_proposals", "label": "Names are labels on hashes; owner adopts canonical, others propose", "file_type": "rationale", "source_file": "docs/peardrive-space-directories.md", "source_location": "Decisions from Guy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces last-writer-wins on names: a 10,000-member movie space can have 10,000 local naming schemes and one canonical index."}, {"id": "docs_peardrive_space_directories_non_destructive", "label": "Non-destructive, like a nonlinear editor", "file_type": "rationale", "source_file": "docs/peardrive-space-directories.md", "source_location": "Decisions from Guy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PearDrive never touches disk unless told; three distinct actions with escalating confirmation: remove from space, delete locally, delete from everywhere. Disconnects are normal, not errors."}, {"id": "docs_peardrive_space_directories_serve_rule", "label": "Serve rule: serve hash H only through a space with a signed link and member peer", "file_type": "rationale", "source_file": "docs/peardrive-space-directories.md", "source_location": "Agreed with Kimi", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard protocol rule, not policy: global hash knowledge is never authorization. Closes the hash-oracle, presence-correlation, probing and malicious-claim cases in Kimi's threat model."}, {"id": "docs_peardrive_space_directories_claim_based_turn_order", "label": "Claim-based soft turn order for agents", "file_type": "concept", "source_file": "docs/peardrive-space-directories.md", "source_location": "Agreed with Kimi", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lead agent has a short window to post a hidden claim marker; silence passes the floor down the room's list, so there is no single point of silence."}], "edges": [{"source": "docs_handoff_peardrive_pearcore_share_by_hash", "target": "docs_peardrive_space_directories_space_directory_model", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/peardrive-space-directories.md", "source_location": "companion to HANDOFF", "weight": 1.0}, {"source": "docs_pear_threads_thread", "target": "docs_peardrive_space_directories_space_directory_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/peardrive-space-directories.md", "source_location": "edge case 15, plan G: threads keyed by (space, hash)", "weight": 1.0}, {"source": "docs_peardrive_coupling_map_catalog", "target": "docs_peardrive_space_directories_local_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/peardrive-space-directories.md", "source_location": "Order: coupling map tells which existing PearDrive state becomes the local index", "weight": 1.0}, {"source": "docs_peardrive_space_directories_space_directory_model", "target": "docs_peardrive_space_directories_local_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/peardrive-space-directories.md", "source_location": "The model", "weight": 1.0}, {"source": "docs_peardrive_space_directories_space_directory_model", "target": "docs_peardrive_space_directories_connection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/peardrive-space-directories.md", "source_location": "The model", "weight": 1.0}, {"source": "docs_peardrive_space_directories_dir_entry_record", "target": "docs_peardrive_space_directories_space_directory_model", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/peardrive-space-directories.md", "source_l