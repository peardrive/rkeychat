{"nodes": [{"id": "docs_pear_threads_thread", "label": "Pear Thread (signed records hanging off a subject)", "file_type": "concept", "source_file": "docs/pear-threads.md", "source_location": "The idea", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A chat room is just a thread whose subject is the room; PearDrive comments are threads whose subject is a file. Protocol, storage, reactions and UI are the same code. By the Pear UI rule, the second consumer (PearDrive) justifies extracting it now."}, {"id": "docs_pear_threads_subject", "label": "Subject (room:, blob:, path:, rec: ids)", "file_type": "concept", "source_file": "docs/pear-threads.md", "source_location": "The idea", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pear_threads_record_kinds", "label": "Record kinds (msg, react, redact, activity)", "file_type": "concept", "source_file": "docs/pear-threads.md", "source_location": "Records", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every record is signed by its author's rKey key and verified against the space's chain so it is trusted when relayed or replayed. Reactions are toggled, last toggle per author/emoji wins. Activity is an agent side channel shown to people and never fed to agents. Rule: strip undefined fields before signing or sending."}, {"id": "docs_pear_threads_nostr_mapping", "label": "Nostr mapping (NIP-22, NIP-25, NIP-73, NIP-94)", "file_type": "concept", "source_file": "docs/pear-threads.md", "source_location": "Nostr mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shapes are chosen to map 1:1 onto Nostr events so mirroring later is mechanical; rKey's domain-separated signature stays the source of truth and a Nostr mirror is a re-encoding, not a second authority."}, {"id": "docs_pear_threads_threads_js", "label": "threads.js (transport-agnostic record library)", "file_type": "concept", "source_file": "docs/pear-threads.md", "source_location": "What gets extracted", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pear_threads_pear_ui_elements", "label": "Pear UI elements (pear-ui.css / pear-ui.js)", "file_type": "concept", "source_file": "docs/pear-threads.md", "source_location": "What gets extracted", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message bubble with continuation grouping, reaction row on the bubble's bottom edge, emoji picker, who-reacted popover, verified lock, detail/thinking overlay, composer with dictation mic and voice memo."}], "edges": [{"source": "docs_handoff_peardrive_pearcore_canonicalstringify_undefined_bug", "target": "docs_pear_threads_record_kinds", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pear-threads.md", "source_location": "Rule: strip undefined (see HANDOFF \u00a73)", "weight": 1.0}, {"source": "docs_handoff_peardrive_pearcore_redact_moderation", "target": "docs_pear_threads_record_kinds", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pear-threads.md", "source_location": "redact record", "weight": 1.0}, {"source": "docs_pear_threads_thread", "target": "docs_pear_threads_subject", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pear-threads.md", "source_location": "The idea", "weight": 1.0}, {"source": "docs_pear_threads_thread", "target": "docs_pear_threads_record_kinds", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pear-threads.md", "source_location": "Records", "weight": 1.0}, {"source": "docs_pear_threads_record_kinds", "target": "docs_pear_threads_nostr_mapping", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1