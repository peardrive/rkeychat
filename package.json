{
  "name": "rkeychat",
  "version": "0.3.5",
  "description": "A room for humans and their agents, on pearcore, with rKey membership.",
  "type": "module",
  "bin": {
    "rkeychat": "bin/rkeychat.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "app:build": "npm --prefix app run build",
    "app": "electron .",
    "dist:mac": "bash scripts/build-app.sh mac",
    "dist:linux": "bash scripts/build-app.sh linux",
    "dist": "bash scripts/build-app.sh",
    "ship": "bash scripts/ship-app.sh",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.108.1",
    "@agentclientprotocol/sdk": "^2.8.0",
    "@noble/hashes": "^2.4.0",
    "hyperdht": "^6.34.0",
    "pearcore": "file:vendor/pearcore-156a268.tgz",
    "pearkit": "file:../pearkit--projects-shell",
    "qrcode": "^1.5.4",
    "rkey": "file:vendor/rkey-66862ba.tgz",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.rkeychat.app",
    "productName": "rKeyChat",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "app": ".",
      "output": "release"
    },
    "files": [
      "electron/**",
      "bin/**",
      "src/**",
      "package.json",
      "app/dist/**",
      "!bench/**",
      "!test/**",
      "!docs/**",
      "!dist/**",
      "!build/**",
      "!vendor/**",
      "!**/.DS_Store",
      "!app/node_modules/**",
      "!app/src/**",
      "!app/scripts/**",
      "!app/screens/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "rKeyChat uses the microphone for dictation and debug notes.",
        "NSCameraUsageDescription": "rKeyChat uses the camera to scan invitation codes.",
        "NSLocalNetworkUsageDescription": "rKeyChat finds your other devices on this network and talks to them directly."
      }
    },
    "dmg": {
      "title": "rKeyChat"
    },
    "icon": "build/icon.png",
    "artifactName": "rkeychat-desktop-${version}-${os}-${arch}.${ext}",
    "linux": {
      "category": "Network",
      "maintainer": "Guy Swann",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "rKeyChat",
          "Comment": "A room for humans and their agents"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
